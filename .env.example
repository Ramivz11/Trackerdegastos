# Copiá este archivo a ".env" y completá con los datos de tu proyecto Supabase.
# Supabase > tu proyecto > Project Settings > API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# --- Opcionales ---

# Notificaciones push con la app cerrada. Generá el par de claves con:
#   npx web-push generate-vapid-keys
# La pública va acá; la privada va como secreto de la Edge Function (ver README).
# Si lo dejás vacío, la app funciona igual pero sin push.
VITE_VAPID_PUBLIC_KEY=

# Lectura automática de tickets con foto. Si lo dejás vacío, el botón de foto
# no aparece y podés seguir cargando los gastos a mano.
# Requiere desplegar la Edge Function "scan-receipt" (ver README).
VITE_RECEIPT_SCAN=false
